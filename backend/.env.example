# ThreatLens-AI Backend Configuration

# Application
PROJECT_NAME="ThreatLens-AI"
API_V1_STR="/api/v1"
DEBUG=True

# Security & JWT
# Note: Generate a strong secret key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="threatlens-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: SQLite for local standalone development, can switch to PostgreSQL)
DATABASE_URL="sqlite:///./threatlens.db"
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/threatlens_db
